    {
      "parameters": {
        "jsCode": "return [\n  {\n    json: {\n      id_pedido: 1041,\n      cliente: \"Elena Morales\",\n      email: \"elena@example.com\",\n      estado: \"entregado\",\n      total: 97.5\n    }\n  },\n  {\n    json: {\n      id_pedido: 1042,\n      cliente: \"Carlos Benítez\",\n      email: \"carlos@example.com\",\n      estado: \"en_reparto\",\n      total: 54.0\n    }\n  },\n  {\n    json: {\n      id_pedido: 1044,\n      cliente: \"Javier Sanz\",\n      email: \"javier@example.com\",\n      estado: \"preparacion\",\n      total: 80.0\n    }\n  },\n  {\n    json: {\n      id_pedido: 9999,\n      cliente: \"Dato Corrupto\",\n      email: \"invalido-sin-arroba\",\n      estado: \"desconocido\",\n      total: -10\n    }\n  }\n];"
      },
      "id": "e03-cargar-dataset",
      "name": "Generar Datos de Prueba",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        360,
        340
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst validos = [];\nconst invalidos = [];\n\nfor (const item of items) {\n  const d = item.json;\n  const emailValido = typeof d.email === 'string' && d.email.includes('@');\n  const totalValido = typeof d.total === 'number' && d.total > 0;\n  \n  if (emailValido && totalValido) {\n    validos.push({ json: { ...d, validacion: 'OK' } });\n  } else {\n    invalidos.push({ json: { ...d, validacion: 'ERROR_DATOS', motivo: !emailValido ? 'Email inválido' : 'Total no positivo' } });\n  }\n}\n\nreturn [validos, invalidos];"
      },
      "id": "e03-validar",
      "name": "Validar Datos Obligatorios",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        580,
        340
      ],
      "outputNames": [
        "Válidos",
        "Inválidos"
      ]
    },
